# Environment Variables for Research Reviewer

# =============================================================================
# BACKEND (Python/FastAPI) - Set these in Render.com or your hosting platform
# =============================================================================

# Required: OpenAI API key for GPT-based reference parsing and relevance scoring
OPENAI_API_KEY=your-openai-api-key-here

# Required: Semantic Scholar API key for paper metadata enrichment
# Get one free at: https://www.semanticscholar.org/product/api
S2_API_KEY=your-semantic-scholar-api-key-here

# Optional: GROBID service URL (for better PDF reference extraction)
# Default: http://localhost:8070
# If running GROBID elsewhere, set this to the service URL
GROBID_URL=http://localhost:8070

# =============================================================================
# FRONTEND (React) - Set these in Netlify or your hosting platform
# =============================================================================

# Backend API URL (without http:// or https:// prefix)
# Local development: localhost:8000
# Production: your-app.onrender.com or your deployed backend domain
REACT_APP_BACKEND_URL=localhost:8000
