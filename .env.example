# Copy to .env (`make setup` does this) and fill in. KEY=value, no quotes.

# Required (uncomment and fill in, or export them in your shell instead)
# CREATEAI_SERVICE_TOKEN=   # ASU CreateAI project service token, see https://docs.aiml.asu.edu/
# S2_API_KEY=

# Recommended: without it, OpenAlex uses a small free daily budget shared by
# everyone on your IP and starts refusing requests (429) once it's used up.
# OPENALEX_API_KEY=

# Optional
# CREATEAI_BASE_URL=https://api-main.aiml.asu.edu/v1
# CREATEAI_MODEL=openai/gpt6_1_sol
# GROBID_URL=http://localhost:8070
# REACT_APP_BACKEND_URL=localhost:8000
# OLMOCR_CMD=python -m olmocr.pipeline
# OLMOCR_TIMEOUT=900
# CITADEL_CACHE=1                 # 0 disables the result cache
# CITADEL_CACHE_DIR=.cache/citadel
# CITADEL_CACHE_TTL_DAYS=30       # max age of Semantic Scholar / OpenAlex entries
