# Copy to .env (`make setup` does this) and fill in. KEY=value, no quotes.

# Required (uncomment and fill in, or export them in your shell instead)
# OPENAI_API_KEY=
# S2_API_KEY=

# Optional
# GROBID_URL=http://localhost:8070
# REACT_APP_BACKEND_URL=localhost:8000
# OLMOCR_CMD=python -m olmocr.pipeline
# OLMOCR_TIMEOUT=900
